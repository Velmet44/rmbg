{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RMBG model manifest",
  "type": "object",
  "required": ["updated", "artifacts"],
  "properties": {
    "updated": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["modelId", "tier", "role", "source", "revision", "license"],
        "properties": {
          "modelId": { "type": "string" },
          "tier": { "enum": ["fast", "quality"] },
          "role": { "enum": ["default-fast", "default-quality", "byom-only", "reference"] },
          "displayName": { "type": "string" },
          "source": { "type": "string" },
          "revision": { "type": "string" },
          "weights": { "type": "string" },
          "baseModel": { "type": "string" },
          "license": { "type": "string" },
          "licenseUrl": { "type": "string" },
          "attribution": { "type": "string" },
          "modifications": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "bytes": { "type": ["number", "null"] },
          "bytesNote": { "type": "string" },
          "checksum": { "type": ["string", "null"] },
          "checksumNote": { "type": "string" },
          "inputSize": { "type": "number" },
          "backends": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    }
  }
}
